PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bigbakebatter
# Generate with: openssl rand -hex 64  (the server refuses to start in production with a weak value)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated storefront + admin origins, no trailing slash. In production an empty list blocks all browsers.
CORS_ORIGINS=http://localhost:5300,http://localhost:5301
SEED_ADMIN_EMAIL=admin@bigbakebatter.com
SEED_ADMIN_PASSWORD=Admin@12345
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# From Razorpay Dashboard → Settings → Webhooks, after adding
# <api-url>/api/payments/webhook as the webhook URL (events: payment.captured,
# payment.failed, refund.processed). Optional locally; REQUIRED in production —
# without it webhooks are rejected.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
